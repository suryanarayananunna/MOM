# Common settings
INTERVAL_SECONDS=6
ALARM_REPEAT_SECONDS=8
UNPRODUCTIVE_STREAK_TO_CLOSE=3
AWAY_IDLE_SECONDS=45

# macOS script settings
SAVE_CAPTURES=0
WEBCAM_CHECK_INTERVAL_SECONDS=120
ENABLE_WEBCAM_LLM=1
SPEAK_QUOTES=0
SCREEN_FLICKER_ENABLED=1
BLOCK_STREAMING_SITES=1
ALERT_SOUND_PATH=/System/Library/Sounds/Funk.aiff

# local model settings (macOS)
MOM_LOCAL_LLM_EXECUTABLE=/opt/homebrew/bin/llama-cli
MOM_LOCAL_LLM_MODEL_PATH=./Models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
MOM_LOCAL_LLM_THREADS=2
MOM_LOCAL_LLM_MAX_TOKENS=96
MOM_LOCAL_LLM_TEMPERATURE=0.1
MOM_LOCAL_LLM_TIMEOUT_SECONDS=25

# Windows settings (PowerShell script)
WINDOWS_BLOCK_KEYWORDS=youtube,netflix,hotstar,prime video,disney+,twitch
WINDOWS_CHECK_INTERVAL_SECONDS=5
WINDOWS_ALERT_REPEAT_SECONDS=10

# Android (ADB) settings
ANDROID_BLOCK_PACKAGES=com.google.android.youtube,com.netflix.mediaclient,in.startv.hotstar
ANDROID_CHECK_INTERVAL_SECONDS=3
ANDROID_ALERT_REPEAT_SECONDS=8
